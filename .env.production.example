# Copy to .env.production and fill in real values. This file is gitignored —
# never commit secrets. It feeds docker-compose.prod.yml in two ways:
#   1. Compose variable interpolation (${VAR} in the YAML).
#   2. Container environment for the `api` service via `env_file`.

# ---- Compose-level ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=trade_crm

# Caddy reverse proxy + TLS (frontend is hosted on S3/CloudFront separately).
API_DOMAIN=api.sprout-crm.com
ACME_EMAIL=you@example.com

# ---- API runtime (injected into the api container via env_file) ----
# Comma-separated allowed origins for CORS.
CORS_ORIGIN=https://sprout-crm.com

# AWS Cognito (server-side auth).
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_vpllPmEOD
COGNITO_CLIENT_ID=53cio0p2dshgeq14olqjcqu1c8
COGNITO_CLIENT_SECRET=CHANGE_ME

# IAM credentials used for Cognito admin operations (user lookup/deletion).
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
