# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=trade_crm
DB_LOGGING=false
DB_SSL=false

# App
PORT=3000
NODE_ENV=development

# AWS Cognito
# Local dev uses the DEV user pool ("sprout-crm-users-dev"). The production
# pool "sprout-crm-users" is NOT used locally — copy the dev client secret
# from the AWS console (sprout-crm-dev app client) into COGNITO_CLIENT_SECRET.
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_Z9LniPmWV
COGNITO_CLIENT_ID=25f91gnsjk83gh5u8tcp227r14
COGNITO_CLIENT_SECRET=your-cognito-dev-client-secret
AWS_ACCESS_KEY_ID=your-iam-access-key
AWS_SECRET_ACCESS_KEY=your-iam-secret-key

# AWS SES (invoice emailing)
# Sending region; SES is enabled in us-east-2 by default.
SES_REGION=us-east-2
# From address for invoice emails. MUST belong to a verified SES identity
# (see infra/lightsail/ses.tf). Falls back to the tenant's businessEmail.
SES_FROM_EMAIL=no-reply@sprout-crm.com

# Feedback notifications (internal)
# Support inbox that receives an email for every in-app feedback submission.
# The value is env-only — the real address is never committed. Replace this
# placeholder before relying on it (sending to it would bounce), or leave the
# variable unset/empty to disable notifications entirely (submissions are then
# recorded as SKIPPED).
FEEDBACK_NOTIFY_EMAIL=sample@email.com

# AI service estimator (Anthropic)
# Server-side only — the key is never exposed to the browser and never
# committed. Leave it unset/empty to disable the estimator: its endpoints then
# return a graceful 503 and every other feature keeps working.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-haiku-5-5 — the cheapest current
# model and a good fit for short catalog matching.
ANTHROPIC_MODEL=claude-haiku-5-5
